# Preserve game-data bytes, including line endings.
* -text

# Show text diffs without normalizing or automatically merging game data.
assets/**/*.ini diff -merge
assets/**/*.txt diff -merge

maps/** diff -merge
ini/** diff -merge

# Normalize maintained text; Windows entrypoints use CRLF.
*.md text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.cmd text eol=crlf
*.ps1 text eol=crlf
tools/**/*.py text eol=lf
tools/.python-version text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
